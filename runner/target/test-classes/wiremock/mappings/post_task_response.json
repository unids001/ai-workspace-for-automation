{
  "request": {
    "method": "POST",
    "url": "/api/v1/tasks",
    "bodyPatterns": [
      { "matchesJsonPath": "$.title" },
      { "matchesJsonPath": "$.description" },
      { "matchesJsonPath": "$.assignee" },
      { "matchesJsonPath": "$.status" }
    ]
  },
  "response": {
    "status": 201,
    "transformers": ["response-template"],
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sample_task_created_response.json"
  }
}

