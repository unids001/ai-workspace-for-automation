{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/login",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.username == 'invalid.user')]" }
    ]
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sample_login_invalid_credentials_response.json"
  }
}

