{
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v1/users/[0-9]+"
  },
  "response": {
    "status": 200,
    "transformers": ["response-template"],
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sample_user_response.json",
    "fixedDelayMilliseconds": 300
  }
}