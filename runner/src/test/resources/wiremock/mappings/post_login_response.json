{
  "request": {
    "method": "POST",
    "url": "/api/v1/auth/login",
    "bodyPatterns": [
      { "matchesJsonPath": "$.username" },
      { "matchesJsonPath": "$.password" }
    ]
  },
  "response": {
    "status": 200,
    "transformers": ["response-template"],
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "sample_login_response.json"
  }
}